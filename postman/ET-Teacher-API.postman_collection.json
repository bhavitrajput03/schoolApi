    "item": [
        {
            "name": "01 Authentication",
            "item": [
                {
                    "name": "Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Login successful', function () { pm.response.to.have.status(200); });",
                                    "const json = pm.response.json();",
                                    "pm.expect(json.success).to.eql(true);",
                                    "pm.expect(json.data.auth.accessToken).to.be.a('string').and.not.empty;",
                                    "pm.collectionVariables.set('accessToken', json.data.auth.accessToken);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"schoolCode\": \"{{schoolCode}}\",\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"fcmToken\": \"{{fcmToken}}\",\n  \"deviceId\": \"{{loginDeviceId}}\",\n  \"platform\": \"android\",\n  \"appVersion\": \"1.0.0\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "login"
                            ]
                        }
                    }
                },
                {
                    "name": "Current User",
                    "request": {
                        "method": "GET",
                        "url": {
